# ==============================================================================
# Share A Plate - Environment Variables Template
# ==============================================================================
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the real .env file or sensitive secrets to version control.
# ==============================================================================

# Server Configuration & Proxy Trust
NODE_ENV=development
PORT=5000
TRUST_PROXY=1
BODY_LIMIT=10kb

# Rate Limiting (DDoS & Brute-Force Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Connections
MONGODB_URI=change-me
MONGODB_URI_TEST=change-me

# Frontend Client URL (for CORS Whitelist)
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Media & Storage Provider (local | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_MAX_SIZE_BYTES=2097152
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Domain Rules & Safety Buffers
SAFETY_BUFFER_MINUTES_DEFAULT=60
URGENCY_THRESHOLD_MINUTES=30

# Database Seed Script Credentials (Development Only)
SEED_ADMIN_EMAIL=admin@shareaplate.org
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO_PASSWORD=change-me

# External Integrations (Stubs & Secrets)
QR_SIGNING_SECRET=change-me
MAPS_API_KEY=change-me
