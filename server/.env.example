# ShareAPlate Backend Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret for signing HttpOnly session cookies
JWT_SECRET=share-a-plate-super-secure-jwt-secret-replace-in-production

# Pre-authorized Admin email addresses (comma separated)
ADMIN_EMAILS=ops@shareaplate.org,admin@shareaplate.org
